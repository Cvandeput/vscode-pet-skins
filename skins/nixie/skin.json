{
  "format": 1,
  "id": "nixie",
  "name": "Nixie",
  "description": "Écran d'ordinateur sur pieds, châssis gris foncé, yeux rouge-orangé qui suivent le curseur. Nommé d'après les tubes Nixie, ces afficheurs en verre sombre à lueur orange.",
  "author": "Corentin Vandeput",
  "license": "MIT",
  "verifiedOn": ["1.132.0"],

  "grid": 24,
  "scale": 4,

  "speechBubble": false,

  "palette": {
    "A": "#454B52",
    "B": "#2E3338",
    "C": "#1B1F23",
    "D": "#0E1114",
    "E": "#121416",
    "F": "#1C2024",
    "G": "#FF6A2B",
    "H": "#FFA55C",
    "I": "#C4380C",
    "J": "#E8EDF2",
    "K": "#372119",
    "L": "#5C3120"
  },

  "roles": {
    "screen": "E",
    "screenFlicker": "F",
    "socket": "D",
    "socketRim": "F",
    "eyeCore": "G",
    "eyeLight": "H",
    "eyeShadow": "I",
    "halo": "K",
    "haloStrong": "L",
    "spark": "J",
    "shadow": "C",
    "outline": "D",
    "bubbleFill": "A",
    "bubbleShine": "J"
  },

  "anchors": {
    "eyes":   { "left": [6, 10], "right": [14, 10], "socket": [4, 4] },
    "screen": [5, 8, 18, 16],
    "body":   [2, 2, 21, 19],
    "feet":   [[5, 20, 8, 22], [15, 20, 18, 22]]
  },

  "animations": {
    "idle":               { "builtin": "idle", "params": { "bob": 1, "bobAt": 20, "blink": [23, 27], "flicker": [8, 44] } },
    "idle-tracking":      { "builtin": "idle", "params": { "bob": 1, "bobAt": 20, "blink": [23, 27], "flicker": [8, 44] } },
    "rendering-tracking": { "builtin": "rendering" },
    "clapping-tracking":  { "builtin": "clapping" },
    "cool":               { "builtin": "cool", "params": { "drop": 3 } },
    "sleep":              { "builtin": "sleep", "params": { "settle": [1, 1, 1, 2, 2, 2, 1, 1] } },
    "waking":             { "builtin": "waking", "params": { "mode": "crt" } },
    "typing":             { "builtin": "typing", "params": { "gaze": [-1, 1], "cursorBlinks": 1, "prop": "screen" } },
    "love":               { "builtin": "love" },
    "speech":             { "builtin": "speech" },
    "yapping":            { "builtin": "yapping", "params": { "widths": [1, 3, 5, 3, 2] } },
    "search":             { "builtin": "search", "params": { "depth": 18, "gaze": 1 } },

    "falling":            { "builtin": "falling", "params": { "lean": [0, 1, 2, 3], "drop": [0, 1, 1, 2] } },
    "jump":               { "builtin": "jump", "params": { "offsets": [1, -1, -2, -2, -1, 1], "squeeze": [2, 0, 0, 0, 0, 1], "feet": [0, -1, -2, -2, -1, 0] } },
    "press-button":       { "builtin": "press-button", "params": { "reach": [0, 0.35, 0.7, 1, 1, 1], "pressFrom": 4 } },
    "respawn":            { "builtin": "respawn", "params": { "materialize": [3, 6, 9, 12, 15, 16] } },
    "revive-sign":        { "builtin": "revive-sign", "params": { "eyes": "dim", "signHalf": 6, "propY1": 8 } },
    "sing":               { "builtin": "sing", "params": { "widths": [3, 6, 4, 7], "bob": [0, -1, 0, -1], "propY0": 15 } },
    "speechless":         { "builtin": "speechless", "params": { "dots": [0, 1, 2, 3, 3] } },
    "splat":              { "builtin": "splat", "params": { "squeeze": [2, 5, 8, 10] } },
    "worry":              { "builtin": "worry", "params": { "shake": [-1, 1] } }
  },

  "base": [
    "........................",
    "........................",
    "..DDDDDDDDDDDDDDDDDDDD..",
    "..DJAAAAAAAAAAAAAAAAAD..",
    "..DABBBBBBBBBBBBBBBBCD..",
    "..DABBBBBBBBBBBBBBBBCD..",
    "..DABBBBBBBBBBBBBBBBCD..",
    "..DBDDDDDDDDDDDDDDDDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDEEEEEEEEEEEEEEDCD..",
    "..DBDDDDDDDDDDDDDDDDCD..",
    "..DCCCCCCCCCCCCCCCCCCD..",
    "..DDDDDDDDDDDDDDDDDDDD..",
    ".....DDDD......DDDD.....",
    ".....DCCD......DCCD.....",
    ".....DDDD......DDDD.....",
    "........................"
  ]
}
